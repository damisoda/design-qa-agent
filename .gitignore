# 의존성(dqa/에서 npm install로 복원)
node_modules/

# 실행 결과(팀 앱 화면·글자 포함)와 사용자 분류 기록
dqa/runs/
dqa/state/

# 평가 중간 결과(팀 PR 인용·화면 캡처 포함)
eval/private/
eval/synth/shots/
eval/synth/*/shots/

# 부산물
__pycache__/
*.pyc
.DS_Store

# Figma에서 가져온 시안(팀 시안이 들어감)
dqa/designs/

# Local RAG evaluation can contain private knowledge excerpts and snapshots.
eval/rag-*/before-retrieval.json
eval/rag-*/after-retrieval.json
eval/rag-*/before-code/
