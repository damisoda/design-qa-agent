{
  "id": "cbh201/start",
  "version": 1,
  "title": "PR201 인증 start",
  "app": "cbh",
  "start": {
    "path": "/"
  },
  "allow_hosts": [],
  "stubs": "../cbh/stubs.json",
  "steps": [
    {
      "wait_text": "시작하기"
    }
  ],
  "ready": {
    "text": "시작하기",
    "stable_ms": 400
  },
  "scan": {
    "root": "#root",
    "scroll": "auto",
    "ignore": []
  },
  "widths": "mobile5",
  "source_hints": [
    "frontend/src/screens/AuthScreen.tsx"
  ],
  "journeys": [
    {
      "id": "auth-navigation",
      "steps": [
        {
          "goto": "/"
        },
        {
          "expect": {
            "selector": "body",
            "contains": "시작하기"
          },
          "name": "시작 화면 로드"
        },
        {
          "click": "[role=\"button\"]:has-text(\"시작하기\")"
        },
        {
          "expect": {
            "selector": "body",
            "contains": "보호자로 시작하기"
          },
          "name": "역할 선택 열림"
        },
        {
          "click": "[role=\"button\"]:has-text(\"보호자로 시작하기\")"
        },
        {
          "expect": {
            "selector": "body",
            "contains": "가입하고 시작하기"
          },
          "name": "보호자 가입 폼"
        },
        {
          "fill": "input[aria-label=\"이메일 주소\"]",
          "value": "guardian.qa@example.test"
        },
        {
          "fill": "input[aria-label=\"비밀번호\"]",
          "value": "mockpass1234"
        },
        {
          "click": "text=이미 계정이 있어요"
        },
        {
          "expect": {
            "selector": "input[aria-label=\"이메일 주소\"]",
            "count": 1
          },
          "name": "로그인 입력칸 유지"
        },
        {
          "click": "text=계정 만들기"
        },
        {
          "expect": {
            "selector": "body",
            "contains": "시민으로 시작하기"
          },
          "name": "역할 선택 복귀"
        },
        {
          "click": "[role=\"button\"]:has-text(\"시민으로 시작하기\")"
        },
        {
          "expect": {
            "selector": "body",
            "contains": "가입하고 시작하기"
          },
          "name": "시민 가입 폼"
        },
        {
          "reload": true
        },
        {
          "expect": {
            "selector": "body",
            "contains": "시작하기"
          },
          "name": "새로고침 뒤 비로그인 상태"
        },
        {
          "click": "[role=\"button\"][aria-label=\"로그인\"]"
        },
        {
          "expect": {
            "selector": "input[aria-label=\"비밀번호\"]",
            "count": 1
          },
          "name": "시작 화면에서 로그인 진입"
        }
      ]
    }
  ]
}